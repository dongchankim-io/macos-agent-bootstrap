# Minimal Core Brewfile
# Install via: brew bundle --file=Brewfile
#
# Philosophy: Keep the base macOS environment fresh and minimal.
# Additional language runtimes and CLI tools are installed on demand by the AI agent
# (see AGENTS.md and catalog/optional-packages.md).

# --- Terminal & Shell UX ---
cask "ghostty"
brew "starship"
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"

# --- Core Editor ---
brew "neovim"
